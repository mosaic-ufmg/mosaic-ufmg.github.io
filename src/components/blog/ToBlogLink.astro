---
import { Icon } from 'astro-icon/components';
import { I18N } from 'astrowind:config';

const { textDirection } = I18N;
---

<div class="mx-auto px-6 sm:px-6 max-w-3xl pt-8 md:pt-4 pb-12 md:pb-20">
  <button
    type="button"
    onclick="
    if (window.history.length > 1) {
      history.back();
    } else {
      window.location.href = '/blog';
    }
  "
    class="px-3 md:px-3 inline-flex items-center"
  >
    {
      textDirection === 'rtl' ? (
        <Icon name="tabler:chevron-right" class="w-5 h-5 mr-1 rtl:mr-0 rtl:ml-1" />
      ) : (
        <Icon name="tabler:chevron-left" class="w-5 h-5 mr-1 rtl:mr-0 rtl:ml-1" />
      )
    }
    Voltar
  </button>
</div>
