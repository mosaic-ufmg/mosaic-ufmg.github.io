---
// Estilização das listas dos blocos dentro das páginas (News, Projetos, Blog, etc)
import Item from '~/components/blog/ListItem.astro';
import type { Post } from '~/types';

export interface Props {
  posts: Array<Post>;
}

const { posts } = Astro.props;
---

<ul>
  {
    posts.map((post) => {
      const isPublicacao = post.category?.slug === 'publicacoes';
      return (
        <li
          class={`${
            isPublicacao
              ? 'mb-1 md:mb-1 bg-gray-100 dark:bg-slate-800 rounded-md p-2 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
              : 'mb-12 md:mb-20'
          }`}
        >
          <Item post={post} />
        </li>
      );
    })
  }
</ul>
